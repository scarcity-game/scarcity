{
  "name": "scarcity-web-acceptance-tests",
  "private": true,
  "version": "0.0.0",
  "description": "Real-browser end-to-end tests for the Scarcity web client against a local docker compose stack.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "bash scripts/run.sh",
    "test:only": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "stack:up": "docker compose -f stack/compose.yaml up --build --wait",
    "stack:down": "docker compose -f stack/compose.yaml down -v --remove-orphans",
    "stack:logs": "docker compose -f stack/compose.yaml logs",
    "browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
