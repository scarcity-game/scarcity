{
  "name": "scarcity-client-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/instrumentation-document-load": "0.70.0",
    "@opentelemetry/instrumentation-fetch": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@opentelemetry/core": "$@opentelemetry/core",
    "@opentelemetry/resources": "$@opentelemetry/resources",
    "@opentelemetry/sdk-trace": "$@opentelemetry/sdk-trace",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/instrumentation": "0.301.0",
    "@opentelemetry/web-common": "0.301.0",
    "@opentelemetry/semantic-conventions": "1.44.0"
  }
}
