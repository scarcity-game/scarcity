{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/scarcity-game/scarcity/content/sprites/sprites.schema.json",
  "title": "Scarcity sprite manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["grid", "categories", "overlays", "effects", "appearances", "patterns", "materials"],
  "properties": {
    "$schema": { "type": "string" },
    "grid": { "const": 32 },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
      "additionalProperties": { "$ref": "#/definitions/category" }
    },
    "overlays": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
      "additionalProperties": { "$ref": "#/definitions/overlay" }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds", "types", "default"],
      "description": "The icons drawn on an entity an effect acts upon, at its frame's `impact` anchor, by the kind of the effect.",
      "properties": {
        "kinds": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "colours"],
            "properties": { "symbol": { "$ref": "#/definitions/symbolId" }, "colours": { "$ref": "#/definitions/colours" } }
          }
        },
        "types": {
          "type": "object",
          "description": "An effect type (a log entry's `loggedEffect.type`) to its kind; any other type is `default`.",
          "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
          "additionalProperties": { "type": "string" }
        },
        "default": { "type": "string" }
      }
    },
    "appearances": {
      "type": "object",
      "description": "A prototype to its default appearance: what an entity of that prototype is drawn as.",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
      "additionalProperties": { "$ref": "#/definitions/appearance" }
    },
    "patterns": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
      "additionalProperties": { "$ref": "#/definitions/pattern" }
    },
    "materials": {
      "type": "object",
      "description": "A wall material (an entity's `material`) to the pattern it is drawn with.",
      "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
      "additionalProperties": { "type": "string" }
    }
  },
  "definitions": {
    "symbolId": { "type": "string", "pattern": "^[a-z][a-z-]*(\\.[a-z][a-z-]*)(\\.[0-9]+)?$" },
    "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "anchorName": { "type": "string", "pattern": "^[a-z][a-z-]*(\\.[a-z][a-z-]*)?$" },
    "anchor": {
      "type": "array",
      "description": "[x, y] or [x, y, degrees] on the 32-unit grid; degrees turn clockwise from pointing right.",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "overlay": {
      "description": "An overlay's symbol, drawn where it is; or one that hangs on an anchor: drawn moved (and turned) from `at` to the frame's anchor.",
      "oneOf": [
        { "$ref": "#/definitions/symbolId" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol", "anchor", "at"],
          "properties": {
            "symbol": { "$ref": "#/definitions/symbolId" },
            "anchor": { "$ref": "#/definitions/anchorName" },
            "at": { "$ref": "#/definitions/anchor", "description": "The anchor where the overlay is drawn in its symbol." }
          }
        }
      ]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "fallbackColor", "slots", "states"],
      "properties": {
        "kind": { "enum": ["static", "animated"] },
        "file": { "type": "string", "pattern": "^categories/[a-z][a-z-]*\\.svg$" },
        "fallbackColor": { "$ref": "#/definitions/colour" },
        "slots": {
          "type": "object",
          "description": "The parts an appearance paints: slot name to what it paints. The frames colour only through these (`var(--sprite-<slot>, #fallback)`); every category has `outline`.",
          "required": ["outline"],
          "properties": { "outline": { "$ref": "#/definitions/slot" } },
          "propertyNames": { "$ref": "#/definitions/slotName" },
          "additionalProperties": { "$ref": "#/definitions/slot" }
        },
        "sample": { "$ref": "#/definitions/colours", "description": "A colour for each slot: what the preview, the contact sheet and `npm run sheet` draw the category in while no appearance uses it." },
        "states": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["static", "idle", "moving", "acting", "acted-upon"] },
          "additionalProperties": { "$ref": "#/definitions/state" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "frameMs"],
      "properties": {
        "frames": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/definitions/symbolId" } },
        "frameMs": { "type": "number", "minimum": 0, "description": "Frame duration in ms; 0 for a static sprite." },
        "anchors": {
          "type": "array",
          "description": "One per frame: the named points of that frame (impact, head, hand.main, ...).",
          "items": { "type": "object", "propertyNames": { "$ref": "#/definitions/anchorName" }, "additionalProperties": { "$ref": "#/definitions/anchor" } }
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "tile", "metres", "fallbackColor", "description"],
      "properties": {
        "file": { "type": "string", "pattern": "^patterns/[a-z][a-z-]*\\.svg$" },
        "tile": { "const": 64, "description": "The tile's side in SVG units; the viewBox is 0 0 64 64." },
        "metres": { "type": "number", "exclusiveMinimum": 0, "description": "How many metres one tile spans in the area." },
        "fallbackColor": { "$ref": "#/definitions/colour" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "colours", "overlays"],
      "properties": {
        "category": { "type": "string" },
        "colours": { "$ref": "#/definitions/colours", "description": "A colour for each of the category's slots." },
        "overlays": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "slotName": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paints"],
      "properties": {
        "paints": { "type": "string", "minLength": 1, "description": "What the slot colours, for whoever picks the colours." },
        "large": { "type": "boolean", "description": "It fills a large area, so its sample colour must stand out from the dark ground (npm test)." }
      }
    },
    "colours": {
      "type": "object",
      "description": "Slot name to colour.",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/definitions/slotName" },
      "additionalProperties": { "$ref": "#/definitions/colour" }
    }
  }
}
