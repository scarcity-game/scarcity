<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root aggregator for all Java modules (services/* and libs/*).
  Shared versions and plugin config live here; modules inherit it.
  Add a new Java module to <modules> and to modules.yaml.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>com.pessimistic-it.scarcity</groupId>
  <artifactId>scarcity-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>scarcity</name>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Boot 3.5.7 manages 1.21.3, which speaks Docker API 1.32. The Docker
         on GitHub runners requires API >= 1.40. 1.21.4 negotiates it. -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <!-- Lint (#105): config in config/lint/, found through .mvn/ marking the root. -->
    <lint.dir>${maven.multiModuleProjectDirectory}/config/lint</lint.dir>
    <checkstyle.version>14.3.0</checkstyle.version>
    <pmd.version>7.28.0</pmd.version>
    <!-- false only to regenerate the baseline (config/lint/README.md) -->
    <lint.failOnViolation>true</lint.failOnViolation>
  </properties>

  <modules>
    <module>libs/resource-model</module>
    <module>services/auth</module>
    <module>services/world</module>
    <module>services/subscriptions</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <environmentVariables>
              <!-- The socket path Ryuk mounts into its container, as seen by
                   the Docker daemon. It is /var/run/docker.sock on Linux CI and
                   inside Docker Desktop's VM. On macOS, pair this with
                   docker.host in ~/.testcontainers.properties (see README) so
                   Testcontainers doesn't probe ~/Library/Containers, which
                   triggers a macOS privacy prompt. -->
              <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
            </environmentVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>3.6.0</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <configLocation>${lint.dir}/checkstyle.xml</configLocation>
            <propertyExpansion>checkstyle.suppressions.file=${lint.dir}/checkstyle-suppressions.xml</propertyExpansion>
            <includeTestSourceDirectory>false</includeTestSourceDirectory>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>${lint.failOnViolation}</failOnViolation>
            <violationSeverity>error</violationSeverity>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>3.28.0</version>
          <dependencies>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-core</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-java</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-javascript</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-jsp</artifactId>
              <version>${pmd.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <rulesets>
              <ruleset>${lint.dir}/pmd-ruleset.xml</ruleset>
            </rulesets>
            <targetJdk>${java.version}</targetJdk>
            <includeTests>false</includeTests>
            <linkXRef>false</linkXRef>
            <printFailingErrors>true</printFailingErrors>
            <failOnViolation>${lint.failOnViolation}</failOnViolation>
            <excludeFromFailureFile>${lint.dir}/pmd-baseline.properties</excludeFromFailureFile>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <!-- Every Java module runs both in verify (CI's test command). Docker
         builds run package, so they don't lint. -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <id>lint-checkstyle</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <executions>
          <execution>
            <id>lint-pmd</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
