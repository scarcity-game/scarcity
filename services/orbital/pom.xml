<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pessimistic-it.scarcity</groupId>
    <artifactId>scarcity-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>scarcity-orbital</artifactId>
  <name>scarcity-orbital</name>
  <description>Plays the entities its principal controls: waits for their turn on the subscriptions WebSocket, then posts an intent.</description>

  <dependencies>
    <!-- The token, world's API, the socket and the turns (libs/service-controller). -->
    <dependency>
      <groupId>com.pessimistic-it.scarcity</groupId>
      <artifactId>service-controller</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Tracing, metrics, semconv span attributes (libs/observability). -->
    <dependency>
      <groupId>com.pessimistic-it.scarcity</groupId>
      <artifactId>observability</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-metrics-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- StubWorld, StubSubscriptions, TestClock, CapturedLogs. -->
    <dependency>
      <groupId>com.pessimistic-it.scarcity</groupId>
      <artifactId>service-controller</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- StubSubscriptions: a JSR-356 endpoint on its own embedded Tomcat. -->
    <dependency>
      <groupId>org.apache.tomcat.embed</groupId>
      <artifactId>tomcat-embed-websocket</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>scarcity-orbital</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
